# ==============================================================================
# DevOpsHub — Multi-Tenant DevOps Mobile Platform Production Environment
# ==============================================================================
APP_ENV=production
ENVIRONMENT=production

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=devops
DATABASE_USER=devops_user
DATABASE_PASSWORD=<generate-strong-random-db-password>

# Redis
REDIS_URL=redis://redis:6379/0

# App Concurrency
WEB_CONCURRENCY=2
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security Keys
JWT_SECRET_KEY=<generate-32-char-random-jwt-secret>
CREDENTIAL_ENCRYPTION_KEY=<generate-fernet-encryption-key>
AGENT_SECRET_KEY=<generate-32-char-agent-secret>

# Network & Domains
CORS_ALLOWED_ORIGINS=https://app.yourcompany.com,https://api.yourcompany.com
DOMAIN_NAME=api.yourcompany.com
