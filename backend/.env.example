# ==============================================================================
# DevOpsHub — Enterprise Production Environment Configuration Template
# ==============================================================================
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in production secrets generated via cryptographically secure tools.
#   3. Never commit the resulting .env file to version control.
# ==============================================================================

# Environment Tier: development | staging | production
APP_ENV=production
ENVIRONMENT=production

# Application Concurrency & Networking
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=60

# PostgreSQL Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=devops
DATABASE_USER=devops_user
DATABASE_PASSWORD=<generate-strong-random-db-password>
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
# Optional explicit full connection string (overrides separate parameters above):
# DATABASE_URL=postgresql+psycopg2://devops_user:<password>@postgres:5432/devops

# Redis Cache & Background Queue
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<generate-32-character-or-longer-secret-key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Symmetric Credential Encryption (Fernet 32 url-safe base64-encoded bytes)
# Generate in python with: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
CREDENTIAL_ENCRYPTION_KEY=<generate-fernet-base64-key>

# DevOps Agent HMAC Token Signing Key
# Generate with: openssl rand -hex 32
AGENT_SECRET_KEY=<generate-32-character-agent-secret-key>

# CORS Whitelist (Comma-separated exact origins, NO wildcard '*' in production)
CORS_ALLOWED_ORIGINS=https://app.yourcompany.com,https://api.yourcompany.com

# Security Hardening & Headers
SECURITY_HEADERS_ENABLED=True
HSTS_ENABLED=True

# Rate Limiting (Requests per minute per IP)
AUTH_RATE_LIMIT_ENABLED=True
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20
OPERATION_RATE_LIMIT=30

# Timeouts & Limits (Seconds)
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=15
MONITORING_CONNECT_TIMEOUT=5
MONITORING_COMMAND_TIMEOUT=5
SERVICE_CONNECTION_TIMEOUT=5
SERVICE_COMMAND_TIMEOUT=10
LOG_CONNECTION_TIMEOUT=5
LOG_COMMAND_TIMEOUT=10
MAX_LOG_RESPONSE_BYTES=1048576

# Docker Settings
DOCKER_CONNECTION_TIMEOUT=5
DOCKER_COMMAND_TIMEOUT=15
DOCKER_LOG_COMMAND_TIMEOUT=10
MAX_DOCKER_LOG_RESPONSE_BYTES=1048576
DOCKER_COMPOSE_COMMAND_TIMEOUT=60

# Deployment Pipeline Settings
DEPLOYMENT_CONNECTION_TIMEOUT=5
DEPLOYMENT_COMMAND_TIMEOUT=60
DEPLOYMENT_MAX_DURATION=1800
MAX_DEPLOYMENT_LOG_LINES=5000
MAX_DEPLOYMENT_LOG_MESSAGE_LENGTH=4000

# Backup Settings
BACKUP_CONNECTION_TIMEOUT=5
BACKUP_COMMAND_TIMEOUT=300
BACKUP_MAX_DURATION=3600
MAX_BACKUP_LOG_LINES=5000
MAX_BACKUP_LOG_MESSAGE_LENGTH=4000

# Alerts & Notifications
ALERT_EVALUATION_INTERVAL_SECONDS=60
ALERT_DEFAULT_DURATION_SECONDS=60
ALERT_ENABLE_BACKGROUND_SCHEDULER=True
MAX_NOTIFICATIONS_LIMIT=100

# Audit Logging & Retention Policies
AUDIT_LOG_ENABLED=True
AUDIT_DEFAULT_LIMIT=50
AUDIT_MAX_LIMIT=100
AUDIT_RETENTION_DAYS=90
JOB_RETENTION_DAYS=60
